<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Energy Solutions</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/9.22.0/firebase-app-compat.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/9.22.0/firebase-database-compat.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/9.22.0/firebase-auth-compat.min.js"></script>
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: Arial, sans-serif; 
            background: linear-gradient(135deg, #f0f9f4 0%, #c8e6c9 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container { max-width: 1200px; margin: 0 auto; }
        .header {
            background: white;
            border-bottom: 3px solid #4CAF50;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }
        .card:hover { transform: translateY(-5px); }
        .simulator-card {
            border-left: 6px solid #4CAF50;
            cursor: pointer;
            position: relative;
        }
        .simulator-card.locked {
            border-left-color: #999;
            opacity: 0.6;
            cursor: not-allowed;
        }
        .simulator-card.locked:hover { transform: none; }
        .btn {
            padding: 14px 28px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 16px;
        }
        .btn-green { background: #4CAF50; color: white; }
        .btn-green:hover { background: #45a049; }
        .btn-white { background: white; color: #4CAF50; border: 2px solid #4CAF50; }
        .btn-white:hover { background: #f0f9f4; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.7);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }
        .modal.active { display: flex; }
        .modal-content {
            background: white;
            border-radius: 16px;
            padding: 30px;
            max-width: 900px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background: #4CAF50;
            color: white;
            font-weight: 600;
        }
        input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
        .lock-icon {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 32px;
        }
        @media (max-width: 768px) {
            .grid-3 { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h1 style="color: #2E7D32; font-size: 28px; margin-bottom: 5px;">⚡ Energy Solutions</h1>
                    <p style="color: #999; font-size: 12px; margin-bottom: 8px; font-style: italic;">Powered by B.U. Progetti Speciali</p>
                    <p id="userName" style="color: #666; font-size: 16px;"></p>
                </div>
                <button class="btn btn-white" onclick="logout()">Esci</button>
            </div>
        </div>

        <div class="card">
            <h2 style="color: #2E7D32; margin-bottom: 20px;">🧮 Simulatori Fiscali</h2>
            <div class="grid-3" id="simulatoriGrid"></div>
        </div>

        <div class="card">
            <h2 style="color: #2E7D32; margin-bottom: 20px;">📋 Gestione</h2>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <button id="btnOpportunita" class="btn btn-green" onclick="window.location.href='index.html?from=dashboard'" style="display: none;">
                    📊 Gestisci Opportunità
                </button>
                <button id="btnPermessi" class="btn btn-white" onclick="openPermissions()" style="display: none;">
                    ⚙️ Gestisci Permessi Utenti
                </button>
            </div>
            <div id="noAccessMessage" style="display: none; padding: 20px; background: #f0f0f0; border-radius: 8px; text-align: center; color: #666;">
                🔒 Non hai accesso alla gestione opportunità. Contatta l'amministratore.
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div style="text-align: center; padding: 30px 20px; color: #999; font-size: 14px;">
        <p style="margin-bottom: 5px;">⚡ <strong style="color: #2E7D32;">Energy Solutions</strong></p>
        <p style="font-size: 12px;">Powered by <strong>B.U. Progetti Speciali</strong></p>
        <p style="font-size: 11px; margin-top: 10px; opacity: 0.7;">© 2026 - Tutti i diritti riservati</p>
    </div>

    <!-- Modal Permessi -->
    <div id="permissionsModal" class="modal">
        <div class="modal-content">
            <h2 style="color: #2E7D32; margin-bottom: 20px;">⚙️ Gestione Permessi Utenti</h2>
            <p style="margin-bottom: 20px; color: #666;">Abilita o disabilita i simulatori e l'accesso alle opportunità per ogni utente</p>
            <div id="permissionsTable"></div>
            <div style="margin-top: 20px; display: flex; gap: 10px;">
                <button class="btn btn-green" onclick="savePermissions()">💾 Salva Modifiche</button>
                <button class="btn btn-white" onclick="closePermissions()">Annulla</button>
            </div>
        </div>
    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyAPdXkLXzz4zjScQX3_buEXGi2OytRfH2o",
            authDomain: "bu-progetti-speciali.firebaseapp.com",
            databaseURL: "https://bu-progetti-speciali-default-rtdb.europe-west1.firebasedatabase.app",
            projectId: "bu-progetti-speciali",
            storageBucket: "bu-progetti-speciali.firebasestorage.app",
            messagingSenderId: "86623187511",
            appId: "1:86623187511:web:2a093d51719b458b4ec5b2"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        
        let currentUser = null;
        let allUsers = [];

        const SIMULATORI = {
            zes: {
                nome: 'ZES Unica 2026',
                icon: '📊',
                descrizione: 'Credito d\'imposta per investimenti in ZES',
                colore: '#f57c00',
                file: 'simulatore-zes.html'
            },
            agrisolare: {
                nome: 'Agrisolare 2026',
                icon: '🌾',
                descrizione: 'Bando fotovoltaico settore agricolo',
                colore: '#0a5f38',
                file: 'simulatore-agrisolare.html'
            },
            iperammortamento: {
                nome: 'Iperammortamento 2026',
                icon: '💎',
                descrizione: 'Industria 5.0 - Credito d\'imposta 180%',
                colore: '#1a4d2e',
                file: 'simulatore-iperammortamento.html'
            },
            sabatini: {
                nome: 'Nuova Sabatini 2026',
                icon: '🏦',
                descrizione: 'Contributo MIMIT per beni strumentali PMI',
                colore: '#0066CC',
                file: 'simulatore-nuova-sabatini-2026.html'
            },
            fotovoltaico: {
                nome: 'Fotovoltaico 2026',
                icon: '☀️',
                descrizione: 'Finanziamento BNP Paribas impianti solari',
                colore: '#FFA500',
                file: 'simulatore-finanziario.html'
            }
        };

        // Check autenticazione
        firebase.auth().onAuthStateChanged(async (firebaseUser) => {
            if (!firebaseUser) {
                window.location.href = 'index.html';
                return;
            }

            try {
                const userSnapshot = await db.ref(`users/${firebaseUser.uid}`).once('value');
                const userData = userSnapshot.val();
                
                if (!userData) {
                    await firebase.auth().signOut();
                    window.location.href = 'index.html';
                    return;
                }

                currentUser = { ...userData, uid: firebaseUser.uid };
                document.getElementById('userName').textContent = 
                    `${currentUser.name} - ${currentUser.role === 'admin' ? 'Amministratore' : 'Utente'}`;

                // Mostra pulsante permessi solo per admin
                if (currentUser.role === 'admin') {
                    document.getElementById('btnPermessi').style.display = 'inline-block';
                    loadAllUsers();
                }

                renderSimulatori();
            } catch (error) {
                console.error('Errore caricamento utente:', error);
                alert('Errore caricamento dati utente');
                await firebase.auth().signOut();
                window.location.href = 'index.html';
            }
        });

        function renderSimulatori() {
            const grid = document.getElementById('simulatoriGrid');
            grid.innerHTML = '';

            const simulatori = currentUser.simulatori || {};

            Object.keys(SIMULATORI).forEach(key => {
                const sim = SIMULATORI[key];
                const hasPermission = simulatori[key] === true;
                
                const card = document.createElement('div');
                card.className = `card simulator-card ${!hasPermission ? 'locked' : ''}`;
                card.style.borderLeftColor = hasPermission ? sim.colore : '#999';
                
                if (hasPermission) {
                    card.onclick = () => openSimulator(sim.file);
                }

                card.innerHTML = `
                    ${!hasPermission ? '<div class="lock-icon">🔒</div>' : ''}
                    <div style="font-size: 48px; margin-bottom: 10px;">${sim.icon}</div>
                    <h3 style="color: ${hasPermission ? sim.colore : '#999'}; margin-bottom: 10px;">
                        ${sim.nome}
                    </h3>
                    <p style="color: #666; font-size: 14px;">
                        ${hasPermission ? sim.descrizione : 'Non autorizzato'}
                    </p>
                `;

                grid.appendChild(card);
            });

            // Gestione accesso opportunità
            const hasOpportunityAccess = currentUser.accessoOpportunita === true || currentUser.role === 'admin';
            const btnOpportunita = document.getElementById('btnOpportunita');
            const noAccessMsg = document.getElementById('noAccessMessage');

            if (hasOpportunityAccess) {
                btnOpportunita.style.display = 'inline-block';
                noAccessMsg.style.display = 'none';
            } else {
                btnOpportunita.style.display = 'none';
                noAccessMsg.style.display = 'block';
            }
        }

        function openSimulator(file) {
            window.open(file, '_blank');
        }

        async function loadAllUsers() {
            try {
                const snapshot = await db.ref('users').once('value');
                const data = snapshot.val();
                allUsers = data ? Object.keys(data).map(uid => ({ uid, ...data[uid] })) : [];
            } catch (error) {
                console.error('Errore caricamento utenti:', error);
            }
        }

        function openPermissions() {
            const modal = document.getElementById('permissionsModal');
            const tableDiv = document.getElementById('permissionsTable');

            let html = `
                <table>
                    <thead>
                        <tr>
                            <th>Utente</th>
                            <th style="text-align: center;">📊 ZES</th>
                            <th style="text-align: center;">🌾 Agris.</th>
                            <th style="text-align: center;">💎 Iper.</th>
                            <th style="text-align: center;">🏦 Sabat.</th>
                            <th style="text-align: center;">☀️ Fotov.</th>
                            <th style="text-align: center;">📋 Opport.</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            allUsers.forEach(user => {
                const sim = user.simulatori || {};
                const hasOpportunita = user.accessoOpportunita === true || user.role === 'admin';
                const isAdmin = user.role === 'admin';
                
                html += `
                    <tr>
                        <td><strong>${user.name}</strong><br><small style="color: #666;">${user.username}${isAdmin ? ' (admin)' : ''}</small></td>
                        <td style="text-align: center;">
                            <input type="checkbox" data-uid="${user.uid}" data-sim="zes" ${sim.zes ? 'checked' : ''}>
                        </td>
                        <td style="text-align: center;">
                            <input type="checkbox" data-uid="${user.uid}" data-sim="agrisolare" ${sim.agrisolare ? 'checked' : ''}>
                        </td>
                        <td style="text-align: center;">
                            <input type="checkbox" data-uid="${user.uid}" data-sim="iperammortamento" ${sim.iperammortamento ? 'checked' : ''}>
                        </td>
                        <td style="text-align: center;">
                            <input type="checkbox" data-uid="${user.uid}" data-sim="sabatini" ${sim.sabatini ? 'checked' : ''}>
                        </td>
                        <td style="text-align: center;">
                            <input type="checkbox" data-uid="${user.uid}" data-sim="fotovoltaico" ${sim.fotovoltaico ? 'checked' : ''}>
                        </td>
                        <td style="text-align: center;">
                            <input type="checkbox" data-uid="${user.uid}" data-perm="opportunita" ${hasOpportunita ? 'checked' : ''} ${isAdmin ? 'disabled' : ''}>
                            ${isAdmin ? '<br><small style="color: #999;">Sempre attivo</small>' : ''}
                        </td>
                    </tr>
                `;
            });

            html += `
                    </tbody>
                </table>
            `;

            tableDiv.innerHTML = html;
            modal.classList.add('active');
        }

        function closePermissions() {
            document.getElementById('permissionsModal').classList.remove('active');
        }

        async function savePermissions() {
            const checkboxes = document.querySelectorAll('#permissionsTable input[type="checkbox"]:not([disabled])');
            const simulatoriUpdates = {};
            const opportunitaUpdates = {};

            checkboxes.forEach(cb => {
                const uid = cb.dataset.uid;
                
                if (cb.dataset.sim) {
                    // Permessi simulatori
                    const sim = cb.dataset.sim;
                    if (!simulatoriUpdates[uid]) simulatoriUpdates[uid] = {};
                    simulatoriUpdates[uid][sim] = cb.checked;
                } else if (cb.dataset.perm === 'opportunita') {
                    // Permesso opportunità
                    opportunitaUpdates[uid] = cb.checked;
                }
            });

            try {
                const promises = [];
                
                // Salva permessi simulatori
                Object.keys(simulatoriUpdates).forEach(uid => {
                    promises.push(db.ref(`users/${uid}/simulatori`).set(simulatoriUpdates[uid]));
                });

                // Salva permessi opportunità
                Object.keys(opportunitaUpdates).forEach(uid => {
                    promises.push(db.ref(`users/${uid}/accessoOpportunita`).set(opportunitaUpdates[uid]));
                });

                await Promise.all(promises);
                alert('✅ Permessi salvati con successo!');
                closePermissions();

                // Ricarica se è l'utente corrente
                if (simulatoriUpdates[currentUser.uid] || opportunitaUpdates.hasOwnProperty(currentUser.uid)) {
                    const snapshot = await db.ref(`users/${currentUser.uid}`).once('value');
                    currentUser = { ...snapshot.val(), uid: currentUser.uid };
                    renderSimulatori();
                }
            } catch (error) {
                console.error('Errore salvataggio:', error);
                alert('❌ Errore salvataggio permessi');
            }
        }

        async function logout() {
            await firebase.auth().signOut();
            window.location.href = 'index.html';
        }
    </script>
</body>
</html>
